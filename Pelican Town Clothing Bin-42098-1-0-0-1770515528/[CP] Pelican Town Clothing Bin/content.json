{
    "Format": "2.8.0",
    "ConfigSchema": {
        "EnableMod": {
            "AllowValues": "true,false",
            "Default": "true",
            "Section": "General"
        },
        "Saturation": {
            "AllowValues": "Vanilla, Desaturated",
            "Default": "Vanilla",
            "Section": "General"
        },
        "IncludeRainbowShell": {
            "AllowValues": "true,false",
            "Default": "true",
            "Section": "General"
        },
        "RainbowShellDay": {
            "AllowValues": "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday",
            "Default": "Monday",
            "Section": "RainbowShells"
        },
        "RainbowShellQty": {
            "AllowValues": "1,2",
            "Default": "1",
            "Section": "RainbowShells"
        },
        "RainbowShellPrice": {
            "AllowValues": "0,100,300,600,1200",
            "Default": "0",
            "Section": "RainbowShells"
        }
    },
    
    "Changes": [

        //Patch the Town map - Vanilla
        {
          "Action": "EditMap",
          "Target": "Maps/Town",
          "FromFile": "maps/ClothingBin.tmx",
          "ToArea": { "X": 66, "Y": 19, "Width": 2, "Height": 2 },
          "PatchMode": "Overlay",
          "MapTiles": [
              {
                  "Layer": "Front",
                  "Position": { "X": 67, "Y": 18 },
                  "Remove": "true"
              },
              {
                  "Layer": "Front",
                  "Position": { "X": 67, "Y": 19 },
                  "Remove": "true"
              }
          ],
          "When": {
            "EnableMod": "true",
            "Saturation": "Vanilla"
          }
        },

        //Patch the Town map - Desaturated
        {
          "Action": "EditMap",
          "Target": "Maps/Town",
          "FromFile": "maps/ClothingBin_desat.tmx",
          "ToArea": { "X": 66, "Y": 19, "Width": 2, "Height": 2 },
          "PatchMode": "Overlay",
          "MapTiles": [
              {
                  "Layer": "Front",
                  "Position": { "X": 67, "Y": 18 },
                  "Remove": "true"
              },
              {
                  "Layer": "Front",
                  "Position": { "X": 67, "Y": 19 },
                  "Remove": "true"
              }
          ],
          "When": {
            "EnableMod": "true",
            "Saturation": "Desaturated"
          }
        },

        //Patch the Town map - Add Shop TileData
        {
          "Action": "EditMap",
          "Target": "Maps/Town",
          "MapTiles": [
              {
                  "Layer": "Buildings",
                  "Position": { "X": 66, "Y": 20 },
                  "SetProperties": {
                      "Action": "OpenShop {{ModId}}_ClothingBin down"
                  }
              },
              {
                  "Layer": "Buildings",
                  "Position": { "X": 67, "Y": 20 },
                  "SetProperties": {
                      "Action": "OpenShop {{ModId}}_ClothingBin down"
                  }
              }
          ],
          "When": {
            "EnableMod": "true"
          }
        },

